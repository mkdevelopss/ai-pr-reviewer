# Copy to .env and fill in. Never commit .env or paste these values into a chat.

# --- Safety: 1 = print actions only (default). Set 0 only for the real demo.
DRY_RUN=1

# --- Dashboard (http://localhost:5000/dashboard): pick any long random phrase.
# Needed because the dashboard can start reviews and merges.
DASHBOARD_TOKEN=

# --- GitHub (test repository only)
# Fine-grained token for the test repo with: Pull requests (read/write),
# Commit statuses (read/write), Contents (read/write - needed to merge)
GITHUB_TOKEN=
# Any long random string; paste the same value into the GitHub webhook settings
WEBHOOK_SECRET=

# --- Tickets: jira or azure
TICKET_SYSTEM=jira
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
# Optional: only these project keys count as ticket IDs (comma-separated)
JIRA_PROJECT_KEYS=
# Optional: custom field id that holds acceptance criteria, e.g. customfield_10050
JIRA_AC_FIELD=

# AZURE_ORG_URL=https://dev.azure.com/your-org
# AZURE_PROJECT=YourProject
# AZURE_PAT=

# --- LLM: openai = any OpenAI-compatible API, or anthropic
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
# Groq (free tier) example:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# Anthropic example:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5

# --- Limits
MAX_DIFF_CHARS=60000
MERGE_METHOD=squash
